<resources>
    <declare-styleable name="TagFlowView">

        <attr name="tagBackgroundColor" format="color" />
        <attr name="tagSelectedBackgroundColor" format="color" />

        <attr name="tagTextColor" format="color" />
        <attr name="tagSelectedTextColor" format="color" />

        <attr name="tagTextSize" format="dimension" />

        <attr name="tagTextStyle">
            <enum name="normal" value="0"/>
            <enum name="bold" value="1"/>
            <enum name="italic" value="2"/>
            <enum name="bold_italic" value="3"/>
        </attr>

        <attr name="tagHorizontalPadding" format="dimension"/>
        <attr name="tagVerticalPadding" format="dimension"/>
        <attr name="tagSpacing" format="dimension"/>
        <attr name="tagLineSpacing" format="dimension"/>
        <attr name="tagCornerRadius" format="dimension"/>
    </declare-styleable>
</resources>