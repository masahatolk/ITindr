<resources>
    <!-- Base application theme. -->
    <style name="Theme.ITindr" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- Customize your theme here. -->

        <item name="background">@drawable/background</item>

        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="Theme.App.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/purple</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ITindr</item>
    </style>

    <!-- Text Styles -->
    <style name="TextHeader">
        <item name="android:textSize">40sp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">inter</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="TextFieldHeader">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">inter</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Button Styles -->
    <style name="WhiteButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>

        <item name="android:backgroundTint">@color/white</item>

        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/black</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="Transparent20Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>

        <item name="android:backgroundTint">@color/white_transparent20</item>

        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="Transparent30Button" parent="Widget.AppCompat.ImageButton">

        <item name="android:background">@drawable/rounded_transparent30_button</item>
    </style>

    <style name="TransparentBadge">
        <item name="android:background">@drawable/rounded_transparent20_button</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">inter</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Input Styles -->
    <style name="Widget.App.TextInputLayout"
        parent="Widget.MaterialComponents.TextInputLayout.FilledBox">

        <item name="boxBackgroundMode">filled</item>

        <item name="boxBackgroundColor">@color/white_transparent20</item>

        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>

        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>

        <item name="boxCollapsedPaddingTop">12dp</item>
    </style>

    <style name="Widget.App.TextInputEditText" parent="Widget.MaterialComponents.TextInputEditText.FilledBox">
        <item name="hintTextColor">@color/white_transparent50</item>
        <item name="android:textColorHint">@color/white_transparent50</item>

        <item name="android:backgroundTint">@color/white_transparent20</item>
        <item name="android:textColor">@color/white</item>

        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="TagFlowView">
        <item name="tagBackgroundColor">@color/white_transparent20</item>
        <item name="tagSelectedBackgroundColor">@color/white</item>

        <item name="tagTextColor">@color/white</item>
        <item name="tagSelectedTextColor">@color/black</item>

        <item name="tagTextSize">16sp</item>
        <item name="tagTextStyle">bold</item>

        <item name="tagHorizontalPadding">12dp</item>
        <item name="tagVerticalPadding">4dp</item>
        <item name="tagSpacing">8dp</item>
        <item name="tagLineSpacing">8dp</item>

        <item name="tagCornerRadius">16dp</item>
    </style>

    <style name="SwipeableProfileTagFlowView" parent="TagFlowView">
        <item name="tagBackgroundColor">@color/black_transparent50</item>
        <item name="tagSelectedBackgroundColor">@color/black_transparent50</item>

        <item name="tagTextColor">@color/white</item>
        <item name="tagSelectedTextColor">@color/white</item>

        <item name="tagTextSize">14sp</item>

    </style>
</resources>