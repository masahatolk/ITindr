<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape>
            <solid android:color="#1F2125"/>
        </shape>
    </item>


    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="600dp"
                android:centerX="1.0"
                android:centerY="0.1"
                android:startColor="#CC5A01FF"
                android:endColor="@android:color/transparent"/>
        </shape>
    </item>


    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="500dp"
                android:centerX="0.0"
                android:centerY="0.55"
                android:startColor="#CCAF01FF"
                android:endColor="@android:color/transparent"/>
        </shape>
    </item>

</layer-list>