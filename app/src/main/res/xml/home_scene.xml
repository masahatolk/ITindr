<MotionScene xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:motion="http://schemas.android.com/apk/res-auto">

    <ConstraintSet android:id="@+id/start">

        <Constraint android:id="@id/logo_container">
            <PropertySet android:alpha="0" />
            <Transform android:translationY="-60dp" />
        </Constraint>

        <Constraint android:id="@id/logo_text">
            <PropertySet android:alpha="0" />
            <Transform android:translationY="-60dp" />
        </Constraint>

        <Constraint android:id="@id/register_home_button">
            <PropertySet android:alpha="0" />
            <Transform android:translationY="60dp" />
        </Constraint>

        <Constraint android:id="@id/login_home_button">
            <PropertySet android:alpha="0" />
            <Transform android:translationY="60dp" />
        </Constraint>

        <Constraint android:id="@id/image_container">
            <PropertySet android:alpha="0" />
        </Constraint>

    </ConstraintSet>


    <ConstraintSet android:id="@+id/end" />


    <Transition
        motion:constraintSetStart="@id/start"
        motion:constraintSetEnd="@id/end"
        motion:duration="1000"
        motion:autoTransition="animateToEnd"
        motion:staggered="0.15"/>

</MotionScene>